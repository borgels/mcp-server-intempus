# Intempus REST API user + key (Intempus → Indstillinger → API-nøgle).
# The key belongs to an Intempus user and every call runs with that
# user's rights. The username is CASE-SENSITIVE.
INTEMPUS_API_USER=
INTEMPUS_API_KEY=
INTEMPUS_BASE_URL=https://intempus.dk/web/v1
INTEMPUS_TIMEOUT_MS=30000
# Roles: "roles" = per request from the gateway's X-MCP-Roles (derived
# from Entra groups; needs INTEMPUS_TRUST_FORWARDED_USER=true), or a fixed
# role/list: "employee" (self-service), "approver" (team view), "admin"
# (company-wide), e.g. "employee,approver". Tools = union of the roles.
INTEMPUS_PROFILE=employee
# Honor the gateway-forwarded X-MCP-User header as the acting identity.
# Required behind the gateway; requests without it are then refused (401).
# Only enable behind a gateway that sets this header itself from a
# verified token.
INTEMPUS_TRUST_FORWARDED_USER=false
# Write tools (register time, approve, admin changes) additionally
# require exactly "true".
INTEMPUS_ENABLE_WRITES=false
# JSONL audit log (who did what; arguments are hashed). Intempus' own
# history shows only the API user, so keep this on in production.
INTEMPUS_AUDIT_LOG=
# Optional Entra UPN → Intempus employee number overrides for employees
# whose Intempus username/work email is not their sign-in address.
# INTEMPUS_IDENTITY_MAP={"jane@onedanmark.dk":"1003"}
# INTEMPUS_IDENTITY_MAP_PATH=/data/identity-map.json
# Approver with a level but no responsible_for_* assignments sees:
# "none" (default) or "all".
INTEMPUS_APPROVER_UNASSIGNED_SCOPE=none
# HMAC secret for prepared admin operations (admin role). Unset: a
# random per-process secret (pending operations die with a restart).
INTEMPUS_OPERATION_SECRET=
# stdio only: acting user for local use (e.g. your own UPN).
INTEMPUS_DEFAULT_USER=
